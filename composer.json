{
    "name": "rafiquljakir/fynoverify",
    "description": "Laravel-first API and authorization regression-testing companion: inventories routes, audits declared test evidence, and recommends verification scenarios.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/Rafiqul-jakir/fynoverify",
    "authors": [
        {
            "name": "Rafiqul Jakir",
            "homepage": "https://github.com/Rafiqul-jakir"
        }
    ],
    "support": {
        "issues": "https://github.com/Rafiqul-jakir/fynoverify/issues",
        "source": "https://github.com/Rafiqul-jakir/fynoverify"
    },
    "keywords": ["laravel", "testing", "api", "routes", "authorization", "regression"],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "larastan/larastan": "^2.9|^3.0",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Rafiquljakir\\FynoVerify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rafiquljakir\\FynoVerify\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rafiquljakir\\FynoVerify\\FynoVerifyServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
